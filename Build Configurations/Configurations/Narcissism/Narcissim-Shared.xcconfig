#include "../Shared.xcconfig"

INFOPLIST_FILE = $(SRCROOT)/Narcissism/Info.plist
PRODUCT_BUNDLE_IDENTIFIER = com.shergin.narcissism
PRODUCT_NAME = Narcissism
CODE_SIGN_ENTITLEMENTS = Narcissism/Narcissism.entitlements

// Single switch for every deliberate undocumented / private API use (see
// SRStatusItemCameraView). Defined for all configurations, App Store
// included; the app has passed review with it. Remove it here to compile
// out all such usage in one move.
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) USE_UNDOCUMENTED_API
