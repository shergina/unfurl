// Posture calibration window
// Echoes the menu item's phrasing, so "for This Camera" is answered by "for
// FaceTime HD Camera". Set as one title rather than a title plus subtitle:
// with no toolbar on the window macOS joins those with an en dash, and "for"
// reads better than a dash. The bare form is the fallback when no device name
// has resolved.
"posture.calibration.title" = "Calibrate Posture";
"posture.calibration.title.camera" = "Calibrate Posture for %@";
"posture.calibration.begin" = "Begin";
"posture.calibration.accept" = "Looks Good";
"posture.calibration.redo" = "Try Again";
"posture.calibration.guidance.not-visible" = "Can't see you - make sure you are in front of the camera.";
"posture.calibration.guidance.face-not-visible" = "Can't see your face clearly - face the camera.";
"posture.calibration.guidance.too-far" = "Move a little closer to the camera.";
// The instruction slot: one line per pose, held unchanged from the gate
// through the countdown and the capture. The gaze lines say "turn your
// head" because the probe measures head pitch - eyes-only compliance
// gives a theta of zero.
"posture.calibration.instruction.middle" = "Turn your head to look at the middle of your screen";
"posture.calibration.instruction.ahead" = "Turn your head to look straight ahead";
// The hold slot: the part that does not change between poses.
"posture.calibration.hold" = "Best posture, hands on your keyboard";
"posture.calibration.measuring" = "Hold still - measuring.";
"posture.calibration.paused" = "Can't see you - measurement paused.";
"posture.calibration.upright-captured" = "Upright posture captured.";
"posture.calibration.finished" = "Calibration finished.";
"posture.calibration.failed.timeout" = "Couldn't get a steady reading. Adjust your position and try again.";
"posture.calibration.failed.unstable" = "The readings varied too much. Sit still and try again.";

